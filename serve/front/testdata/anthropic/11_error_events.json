{
  "name": "error_events",
  "method": "POST",
  "path": "/v1/messages",
  "stream_error": {
    "event": "error",
    "data": {
      "type": "error",
      "error": {
        "type": "invalid_request_error",
        "message": "Malformed prompt"
      }
    }
  },
  "http_error_400": {
    "status": 400,
    "response": {
      "type": "error",
      "error": {
        "type": "invalid_request_error",
        "message": "'messages' is required"
      }
    }
  }
}
