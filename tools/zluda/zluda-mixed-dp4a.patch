diff --git a/ptx/src/pass/llvm/emit.rs b/ptx/src/pass/llvm/emit.rs
index 079a801..e4e4749 100644
--- a/ptx/src/pass/llvm/emit.rs
+++ b/ptx/src/pass/llvm/emit.rs
@@ -3550,7 +3550,7 @@ impl<'a> MethodEmitContext<'a> {
             (ast::ScalarType::S32, ast::ScalarType::S32) => c"llvm.amdgcn.sdot4",
             (ast::ScalarType::U32, ast::ScalarType::S32)
             | (ast::ScalarType::S32, ast::ScalarType::U32) => {
-                return Err(error_todo_msg("dp4a with mixed types is not yet supported"))
+                return self.emit_dp4a_mixed(data, arguments)
             }
             _ => return Err(error_unreachable()),
         };
@@ -3579,6 +3579,55 @@ impl<'a> MethodEmitContext<'a> {
         Ok(())
     }
 
+    // llvm.amdgcn.sudot4 needs dot8-insts (gfx11+), and the module is not
+    // compiled for a known arch here, so mixed signedness is open-coded.
+    fn emit_dp4a_mixed(
+        &mut self,
+        data: ast::Dp4aDetails,
+        arguments: ast::Dp4aArgs<SpirvWord>,
+    ) -> Result<(), TranslateError> {
+        let builder = self.builder;
+        let i8_type = get_scalar_type(self.context, ast::ScalarType::B8);
+        let i32_type = get_scalar_type(self.context, data.ctype());
+        let v4i8 = unsafe { LLVMVectorType(i8_type, 4) };
+        let v4i32 = unsafe { LLVMVectorType(i32_type, 4) };
+        let widen = |value: LLVMValueRef, type_: ast::ScalarType| unsafe {
+            let bytes = LLVMBuildBitCast(builder, value, v4i8, LLVM_UNNAMED.as_ptr());
+            if type_ == ast::ScalarType::S32 {
+                LLVMBuildSExt(builder, bytes, v4i32, LLVM_UNNAMED.as_ptr())
+            } else {
+                LLVMBuildZExt(builder, bytes, v4i32, LLVM_UNNAMED.as_ptr())
+            }
+        };
+        let src1 = widen(self.resolver.value(arguments.src1)?, data.atype);
+        let src2 = widen(self.resolver.value(arguments.src2)?, data.btype);
+        let mut acc = self.resolver.value(arguments.src3)?;
+        let products = unsafe { LLVMBuildMul(builder, src1, src2, LLVM_UNNAMED.as_ptr()) };
+        for i in 0..3 {
+            acc = unsafe {
+                let lane = LLVMBuildExtractElement(
+                    builder,
+                    products,
+                    LLVMConstInt(i32_type, i, 0),
+                    LLVM_UNNAMED.as_ptr(),
+                );
+                LLVMBuildAdd(builder, acc, lane, LLVM_UNNAMED.as_ptr())
+            };
+        }
+        let last = unsafe {
+            LLVMBuildExtractElement(
+                builder,
+                products,
+                LLVMConstInt(i32_type, 3, 0),
+                LLVM_UNNAMED.as_ptr(),
+            )
+        };
+        self.resolver.with_result(arguments.dst, |dst| unsafe {
+            LLVMBuildAdd(builder, acc, last, dst)
+        });
+        Ok(())
+    }
+
     fn emit_trap(&mut self) -> Result<(), TranslateError> {
         self.emit_intrinsic(c"llvm.trap", None, vec![], vec![])?;
         unsafe { LLVMBuildUnreachable(self.builder) };
