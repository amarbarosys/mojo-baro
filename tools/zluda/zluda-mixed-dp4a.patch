diff --git a/ptx/src/test/spirv_run/dp4a_mixed.ptx b/ptx/src/test/spirv_run/dp4a_mixed.ptx
new file mode 100644
index 0000000..2310400
--- /dev/null
+++ b/ptx/src/test/spirv_run/dp4a_mixed.ptx
@@ -0,0 +1,29 @@
+.version 6.5
+.target sm_70
+.address_size 64
+
+.visible .entry dp4a_mixed(
+    .param .u64 input,
+    .param .u64 output
+)
+{
+    .reg .u64       in_addr;
+    .reg .u64       out_addr;
+    .reg .b32       src1;
+    .reg .b32       src2;
+    .reg .b32       src3;
+    .reg .b32       su;
+    .reg .b32       us;
+
+    ld.param.u64    in_addr, [input];
+    ld.param.u64    out_addr, [output];
+
+    ld.b32          src1, [in_addr];
+    ld.b32          src2, [in_addr+4];
+    ld.b32          src3, [in_addr+8];
+    dp4a.s32.u32    su, src1, src2, src3;
+    dp4a.u32.s32    us, src1, src2, src3;
+    st.b32          [out_addr], su;
+    st.b32          [out_addr+4], us;
+    ret;
+}
