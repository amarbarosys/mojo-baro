"""Rebuild index.md and llms.db of the model-skill library from its folders.

usage: mojo build tools/llm-skills-index.mojo -o OUT; OUT [ROOT]     (ROOT default ~/Brain/Skills/llms-skills)
Each ROOT/<key>/ with a card.kv (key=value lines: path sha arch params quant ctx tok_s good_at bad_at updated) is one
model. Writes ROOT/index.md (one line per model) and ROOT/llms.db through the sqlite3 CLI: table models(key, path, sha,
arch, params, quant, ctx, tok_s, good_at, bad_at, skill_path, updated), table files(key, kind, path). The db is dropped
and rebuilt every run. Exit non-zero (FAIL <step>: <reason>) on a missing SKILL.md or an unreadable card.
"""
from std.sys import argv
from std.os import listdir, getenv
from std.os.path import isdir, exists
from std.ffi import external_call


def q(s: String) -> String:
    return "'" + s.replace("'", "''") + "'"


def kind_of(name: String, sub: String) -> String:
    if sub == "docs":
        return "doc"
    if sub == "runs":
        return "run"
    if name == "SKILL.md":
        return "skill"
    if name == "chat_template.jinja":
        return "chat_template"
    if name == "system_prompt.md":
        return "system_prompt"
    if name == "baro.json":
        return "baro"
    if name == "gguf-meta.json":
        return "gguf_meta"
    if name == "card.kv":
        return "card"
    return "other"


def get(kv: List[String], key: String) -> String:
    var p = key + "="
    for i in range(len(kv)):
        if kv[i].startswith(p):
            return String(kv[i][byte = p.byte_length() :])
    return String("")


def main() raises:
    var args = argv()
    var root = String(getenv("HOME")) + "/Brain/Skills/llms-skills"
    if len(args) > 1:
        root = String(args[1])
    var names = listdir(root)
    var sql = String("")
    sql += "CREATE TABLE models(key TEXT PRIMARY KEY, path TEXT, sha TEXT, arch TEXT, params TEXT, quant TEXT, ctx TEXT, tok_s TEXT, good_at TEXT, bad_at TEXT, skill_path TEXT, updated TEXT);\n"
    sql += "CREATE TABLE files(key TEXT, kind TEXT, path TEXT);\nBEGIN;\n"
    var idx = String("# llms-skills index\n\nOne line per model. Generated by `tools/llm-skills-index.mojo` (mojo-baro); do not edit.\n\n")
    var n = 0
    for ni in range(len(names)):
        var key = String(names[ni])
        var dir = root + "/" + key
        if not isdir(dir) or not exists(dir + "/card.kv"):
            continue
        if not exists(dir + "/SKILL.md"):
            print("FAIL skill: " + key + " has card.kv but no SKILL.md")
            raise Error("missing SKILL.md")
        var kv = List[String]()
        for ln in open(dir + "/card.kv", "r").read().splitlines():
            kv.append(String(ln))
        var skill = dir + "/SKILL.md"
        sql += (
            "INSERT INTO models VALUES(" + q(key) + "," + q(get(kv, "path")) + "," + q(get(kv, "sha")) + ","
            + q(get(kv, "arch")) + "," + q(get(kv, "params")) + "," + q(get(kv, "quant")) + "," + q(get(kv, "ctx"))
            + "," + q(get(kv, "tok_s")) + "," + q(get(kv, "good_at")) + "," + q(get(kv, "bad_at")) + ","
            + q(skill) + "," + q(get(kv, "updated")) + ");\n"
        )
        var top = listdir(dir)
        for fi in range(len(top)):
            var f = String(top[fi])
            var p = dir + "/" + f
            if isdir(p):
                if f != "docs" and f != "runs":
                    continue
                var sub = listdir(p)
                for si in range(len(sub)):
                    var sf = String(sub[si])
                    sql += "INSERT INTO files VALUES(" + q(key) + "," + q(kind_of(sf, f)) + "," + q(p + "/" + sf) + ");\n"
            else:
                sql += "INSERT INTO files VALUES(" + q(key) + "," + q(kind_of(f, "")) + "," + q(p) + ");\n"
        idx += (
            "- [" + key + "](" + key + "/SKILL.md): " + get(kv, "params") + " " + get(kv, "arch") + " "
            + get(kv, "quant") + ", ctx " + get(kv, "ctx") + ", " + get(kv, "tok_s") + " tok/s. Good: "
            + get(kv, "good_at") + " Bad: " + get(kv, "bad_at") + "\n"
        )
        n += 1
    sql += "COMMIT;\n"
    with open(root + "/index.md", "w") as f:
        f.write(idx)
    with open(root + "/llms.sql", "w") as f:
        f.write(sql)
    var cmd = "rm -f '" + root + "/llms.db' && sqlite3 '" + root + "/llms.db' < '" + root + "/llms.sql' && rm -f '" + root + "/llms.sql'"
    var rc = external_call["system", Int32](cmd.as_c_string_span().ptr())
    if rc != 0:
        print("FAIL sqlite: sqlite3 exited non-zero")
        raise Error("sqlite3 failed")
    print("indexed " + String(n) + " model(s) -> " + root + "/index.md, llms.db")
