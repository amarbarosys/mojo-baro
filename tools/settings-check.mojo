# settings-check: gate and README generator for docs/settings.toml, the single source of every setting.
# TOML via DataBooth/mojo-toml, vendored at repo root as toml/.
# build: mojo build tools/settings-check.mojo -I . -o .work/settings-check (tools/ci-checks.sh does this)
#
# usage: .work/settings-check [--toml FILE]        check; exit 0 = PASS, 1 = FAIL (also checks the README table)
#        .work/settings-check --readme             rewrite the README "Configuration" table between its markers
# Checks: every BARO_* the code reads (getenv and get_defined_* in .mojo under serve/ kernels/ tools/, env::var in
# serve/src/*.rs, $BARO_* in tools/baro; kind external = read by MAX, not by us) has a [[setting]]; every env [[setting]] is still read; request fields
# (SamplerFields in serve/src/main.rs, plus max_tokens) match the sampling.* request keys; schema, ranges, sources,
# presets; docs/settings-template.toml (read by tools/profile) lists the same keys; the README table is current.
# Gotcha: --toml FILE checks a copy for the falsifier in tools/ci-checks.sh (a deleted or invented entry must fail).
from std.sys import argv, exit, stderr
from std.subprocess import run
from std.os.path import exists
from toml import parse, TomlValue

comptime BEGIN = "<!-- settings-table:begin (generated by tools/settings-check --readme; edit docs/settings.toml) -->"
comptime END = "<!-- settings-table:end -->"


def root() raises -> String:
    var exe = String(run("realpath -- '" + String(argv()[0]) + "'").strip())
    return String(run("dirname -- \"$(dirname -- '" + exe + "')\"").strip())


def read(path: String) raises -> String:
    with open(path, "r") as f:
        return f.read()


def sh(cmd: String) raises -> List[String]:
    var out = List[String]()
    for l in String(run(cmd)).split("\n"):
        var s = String(l.strip())
        if s != "":
            out.append(s)
    return out^


def has(xs: List[String], x: String) -> Bool:
    for y in xs:
        if y == x:
            return True
    return False


def num(v: TomlValue) raises -> Float64:
    return Float64(v.as_int()) if v.is_int() else v.as_float()


def tstr(t: Dict[String, TomlValue], k: String) raises -> String:
    return t[k].as_string() if k in t and t[k].is_string() else ""


def words(s: String) -> List[String]:
    var out = List[String]()
    for w in s.split(" "):
        out.append(String(w))
    return out^


def one_of(x: String, xs: List[String]) -> Bool:
    return has(xs, x)


def code_names(r: String) raises -> Dict[String, String]:
    """BARO_ names the code reads -> kind (env | build | server-env | shell), as tools/settings-check.py did."""
    var found = Dict[String, String]()
    var kinds = List[String]()
    var cmds = List[String]()
    kinds.append("env")
    cmds.append("cd '" + r + "' && grep -rhoE --include='*.mojo' 'getenv\\(\"BARO_[A-Z0-9_]+\"' serve kernels tools | grep -oE 'BARO_[A-Z0-9_]+'")
    kinds.append("build")
    cmds.append("cd '" + r + "' && grep -rhoE --include='*.mojo' 'get_defined_(string|int|bool)\\[\"BARO_[A-Z0-9_]+\"' serve kernels tools | grep -oE 'BARO_[A-Z0-9_]+'")
    kinds.append("server-env")
    cmds.append("cd '" + r + "' && grep -hoE 'env::var\\(\"BARO_[A-Z0-9_]+\"' serve/src/*.rs | grep -oE 'BARO_[A-Z0-9_]+'")
    kinds.append("shell")
    cmds.append("cd '" + r + "' && grep -hoE '\\$\\{?BARO_[A-Z0-9_]+' tools/baro | grep -oE 'BARO_[A-Z0-9_]+'")
    for i in range(len(kinds)):
        for n in sh(cmds[i]):
            if kinds[i] == "build":
                found[n] = "build"
            elif n not in found:
                found[n] = kinds[i]
    return found^


def request_names(r: String) raises -> List[String]:
    var out = sh("cd '" + r + "' && awk '/^struct SamplerFields \\{/{f=1;next} f&&/^\\}/{f=0} f&&/^    [a-z_]+: Option</{sub(\":.*\",\"\");gsub(/ /,\"\");print}' serve/src/main.rs")
    if len(sh("cd '" + r + "' && grep -nE '^ +max_tokens: Option<u32>' serve/src/main.rs")) > 0:
        out.append("max_tokens")
    return out^


def dval(t: Dict[String, TomlValue]) raises -> String:
    if "default" not in t:
        return "unset"
    var v = t["default"].copy()
    if v.is_bool():
        return "`1`" if v.as_bool() else "`0`"
    if v.is_string():
        return "`" + v.as_string() + "`"
    if v.is_int():
        return "`" + String(v.as_int()) + "`"
    return "`" + String(v.as_float()) + "`"


def table(settings: List[TomlValue]) raises -> String:
    var s = String("| setting | default | what it does |\n|---|---|---|\n")
    for e in settings:
        var t = e.as_table()
        if tstr(t, "level") == "basic" and tstr(t, "kind") != "request":
            s += "| `" + tstr(t, "key") + "` | " + dval(t) + " | " + String(tstr(t, "summary").replace("|", "\\|")) + " |\n"
    return s^


def check_value(v: TomlValue, t: Dict[String, TomlValue], where: String, mut errs: List[String]) raises:
    var ty = tstr(t, "type")
    if ty == "int" and not v.is_int():
        errs.append(where + ": not an int")
    elif ty == "float" and not (v.is_float() or v.is_int()):
        errs.append(where + ": not a float")
    elif ty == "bool" and not v.is_bool():
        errs.append(where + ": not a bool")
    elif (ty == "path" or ty == "string" or ty == "enum") and not v.is_string():
        errs.append(where + ": not a string")
    elif ty == "enum" and v.is_string() and "choices" in t:
        var ok = False
        for c in t["choices"].as_array():
            if c.as_string() == v.as_string():
                ok = True
        if not ok:
            errs.append(where + ": '" + v.as_string() + "' not in choices")
    if (ty == "int" or ty == "float") and (v.is_int() or v.is_float()):
        if "min" in t and num(v) < num(t["min"]):
            errs.append(where + ": below min")
        if "max" in t and num(v) > num(t["max"]):
            errs.append(where + ": above max")


def run_main() raises:
    var args = argv()
    var r = root()
    var path = r + "/docs/settings.toml"
    var gen = False
    var i = 1
    while i < len(args):
        if String(args[i]) == "--toml" and i + 1 < len(args):
            path = String(args[i + 1])
            i += 1
        elif String(args[i]) == "--readme":
            gen = True
        else:
            print("usage: settings-check [--toml FILE] | --readme", file=stderr)
            exit(1)
        i += 1
    if not exists(path):
        print("FAIL settings-check: " + path + " does not exist")
        exit(1)
    var d = parse(read(path))
    var settings = d["setting"].as_array()
    var presets = d["preset"].as_array() if "preset" in d else List[TomlValue]()
    var readme = read(r + "/README.md")
    var b = readme.find(BEGIN)
    var e = readme.find(END)
    if b < 0 or e < b:
        print("FAIL settings-check: README.md has no settings-table markers")
        exit(1)
    var fresh = String(readme[byte = 0 : b]) + BEGIN + "\n\n" + table(settings) + "\n" + String(readme[byte = e :])
    if gen:
        with open(r + "/README.md", "w") as f:
            f.write(fresh)
        print("README table written: " + String(len(table(settings).split("\n")) - 3) + " rows")
        return

    var errs = List[String]()
    var by_key = Dict[String, Dict[String, TomlValue]]()
    var groups = words("sampling engine model front")
    var types = words("int float bool enum path string")
    var levels = words("basic advanced")
    var stats = words("stable experimental bench-only")
    var kindsok = words("env build server-env shell external request")
    var must = words("key group label type kind restart level status models sources summary help")
    for s in settings:
        var t = s.as_table()
        var k = tstr(t, "key")
        for m in must:
            if m not in t:
                errs.append(k + ": missing key '" + m + "'")
        if k in by_key:
            errs.append(k + ": duplicate entry")
        by_key[k] = t.copy()
        if not one_of(tstr(t, "group"), groups):
            errs.append(k + ": bad group")
        if not one_of(tstr(t, "type"), types):
            errs.append(k + ": bad type")
        if not one_of(tstr(t, "level"), levels):
            errs.append(k + ": bad level")
        if not one_of(tstr(t, "status"), stats):
            errs.append(k + ": bad status")
        if not one_of(tstr(t, "kind"), kindsok):
            errs.append(k + ": bad kind")
        if "restart" in t and not t["restart"].is_bool():
            errs.append(k + ": restart must be a bool")
        if tstr(t, "summary") == "" or tstr(t, "help") == "":
            errs.append(k + ": empty summary or help")
        if tstr(t, "type") == "enum" and ("choices" not in t or len(t["choices"].as_array()) == 0):
            errs.append(k + ": enum without choices")
        if "min" in t and "max" in t and num(t["min"]) > num(t["max"]):
            errs.append(k + ": min above max")
        if "default" in t:
            check_value(t["default"], t, k + " default", errs)
        if "sources" in t:
            for src in t["sources"].as_array():
                if not exists(r + "/" + src.as_string()):
                    errs.append(k + ": source " + src.as_string() + " does not exist")

    var code = code_names(r)
    for item in code.items():
        if item.key not in by_key:
            errs.append("missing from docs/settings.toml: " + item.key + " (" + item.value + ")")
    for item in by_key.items():
        var t = item.value.copy()
        if tstr(t, "kind") != "request" and tstr(t, "kind") != "external" and item.key not in code:
            errs.append("in docs/settings.toml but not read by the code: " + item.key)
        elif tstr(t, "kind") != "request" and tstr(t, "kind") != "external" and item.key in code:
            var ck = code[item.key]
            var tk = tstr(t, "kind")
            if tk != ck and not (ck == "shell" or tk == "shell"):
                errs.append(item.key + ": kind '" + tk + "' but the code reads it as '" + ck + "'")
    var req = request_names(r)
    for q in req:
        if ("sampling." + q) not in by_key:
            errs.append("request field missing from docs/settings.toml: sampling." + q)
    for item in by_key.items():
        if tstr(item.value, "kind") == "request":
            if item.key.startswith("sampling."):
                if not has(req, String(item.key.removeprefix("sampling."))):
                    errs.append("request key gone from the front: " + item.key)
            else:  # a nested request field (chat_template_kwargs.NAME): its last segment must still be in the Rust front
                var leaf = String(item.key[byte = item.key.rfind(".") + 1 :])
                if len(sh("cd '" + r + "' && grep -nw '" + leaf + "' serve/src/main.rs")) == 0:
                    errs.append("request key gone from the front: " + item.key)
    var tmpl_path = r + "/docs/settings-template.toml"
    if exists(tmpl_path):
        var tm = parse(read(tmpl_path))["settings"].as_table()
        for item in tm.items():
            if item.key not in by_key:
                errs.append("docs/settings-template.toml has " + item.key + " but docs/settings.toml does not")
        for item in by_key.items():
            if tstr(item.value, "kind") != "request" and tstr(item.value, "kind") != "shell" and item.key not in tm:
                errs.append("docs/settings.toml has " + item.key + " but docs/settings-template.toml (tools/profile) does not")
    for p in presets:
        var pt = p.as_table()
        var pn = tstr(pt, "name")
        if pn == "" or tstr(pt, "summary") == "" or not one_of(tstr(pt, "group"), words("speed task fit user")):
            errs.append("preset '" + pn + "': needs name, summary and group speed|task|fit|user")
        if "values" not in pt:
            errs.append("preset '" + pn + "': no values")
            continue
        for item in pt["values"].as_table().items():
            if item.key not in by_key:
                errs.append("preset '" + pn + "': unknown setting " + item.key)
            else:
                check_value(item.value, by_key[item.key], "preset '" + pn + "' " + item.key, errs)
    if fresh != readme:
        errs.append("README.md settings table is stale: run .work/settings-check --readme")

    if len(errs) > 0:
        print("FAIL settings-check: " + String(len(errs)) + " problem(s), " + String(len(by_key)) + " settings, " + String(len(code)) + " read by the code")
        for x in errs:
            print("  " + x)
        exit(1)
    print("PASS settings-check: " + String(len(by_key)) + " settings (" + String(len(code)) + " read by the code, " + String(len(req)) + " request fields), " + String(len(presets)) + " presets, README table current")


def main():
    try:
        run_main()
    except e:
        print("FAIL settings-check: " + String(e), file=stderr)
        exit(1)
